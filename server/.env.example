PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=300

JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-me-with-another-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_COOKIE_NAME=intellmeet_refresh
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
REDIS_URL=redis://127.0.0.1:6379

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
AI_TRANSCRIPTION_TIMEOUT_MS=90000
AI_SUMMARY_TIMEOUT_MS=60000
